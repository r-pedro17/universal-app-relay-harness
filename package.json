{
  "name": "universal-app-relay-harness",
  "private": true,
  "version": "0.1.0",
  "description": "A lightweight headless test harness and CLI relay for web and native apps.",
  "type": "module",
  "packageManager": "pnpm@10.15.1",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "test": "pnpm build && node --test examples/tests/*.test.mjs",
    "harness": "pnpm --filter @app-relay/hub start",
    "demo:web": "node examples/web-demo/server.mjs",
    "check:ios": "cd packages/client-ios && swift build"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}